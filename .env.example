# Copy to .env in this project. Empty future integrations are ignored.
MG_APP_NAME=MeterGate
MG_ENVIRONMENT=development
MG_LOG_LEVEL=INFO

# Local development values matching deploy/compose.dev.yml. Do not use for deployment.
# MG_DATABASE_URL=postgresql+asyncpg://metergate:metergate_dev_only@127.0.0.1:55432/metergate
# MG_REDIS_URL=redis://127.0.0.1:56379/0
# Fill these in your ignored .env when doing the day-02 connection exercise.
MG_DATABASE_URL=postgresql+asyncpg://metergate:metergate_dev_only@127.0.0.1:55432/metergate
MG_REDIS_URL=redis://127.0.0.1:56379/0
MG_JWT_SECRET=
MG_JWT_ISSUER=metergate
MG_JWT_AUDIENCE=metergate-api
MG_ACCESS_TOKEN_MINUTES=15
MG_HEALTH_TIMEOUT_SECONDS=3
